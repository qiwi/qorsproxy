{
  "name": "@qiwi/qorsproxy",
  "alias": "qorsproxy",
  "version": "4.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "HTTP(S) proxy for dev purposes",
  "type": "module",
  "types": "./src/main/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/main/js/index.d.ts",
      "import": "./src/main/js/index.js"
    }
  },
  "bin": {
    "qors": "src/main/js/cli.js",
    "qorsproxy": "src/main/js/cli.js"
  },
  "scripts": {
    "start:pm2": "pm2 start npm --name qorsproxy -- start",
    "start": "node src/main/js/cli.js",
    "start:bun": "bun src/main/js/cli.js",
    "build": "yarn build:docs",
    "build:docs": "mkdir -p docs && cp -r README.md docs/README.md",
    "test": "concurrently -m 2 --kill-others-on-fail 'npm:test:*'",
    "test:unit": "vitest run --coverage",
    "test:smoke": "node src/test/smoke/cli.test.js",
    "test:lint": "oxlint",
    "test:depcheck": "npm_config_yes=true npx depcheck",
    "test:depaudit": "yarn npm audit --environment production --severity=moderate",
    "lint:fix": "oxlint --fix",
    "publish:beta": "npm publish --no-git-tag-version --tag beta",
    "publish:rc": "npm publish --no-git-tag-version --tag rc"
  },
  "dependencies": {
    "@qiwi/health-indicator": "^2.0.4",
    "@qiwi/primitive-storage": "^2.0.1",
    "basic-auth": "^2.0.1",
    "express": "^4.22.3",
    "http-status-codes": "^2.3.0",
    "js-yaml": "^4.1.1",
    "jsonschema": "^1.5.0",
    "lodash-es": "^4.18.1",
    "mri": "^1.2.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "license": "MIT",
  "files": [
    "src/main",
    "example",
    "ssl"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "oxlint": "^1.86.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "cors",
    "corsproxy",
    "qors",
    "qorsproxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiwi/qorsproxy.git"
  },
  "author": "Anton Golub <a.golub@qiwi.com>",
  "engines": {
    "node": ">=16",
    "npm": ">=5.6"
  },
  "packageManager": "yarn@4.18.1"
}
